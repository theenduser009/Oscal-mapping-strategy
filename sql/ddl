SELECT
    SOURCE_RECORD_ID,
    OSCAL_UUID,
    METADATA_JSON:type::STRING        AS COMPONENT_TYPE,
    METADATA_JSON:title::STRING       AS TITLE,
    METADATA_JSON:description::STRING AS DESCRIPTION,
    METADATA_JSON
FROM RTX_ENTERPRISESERVICES_DEV.ES_ESC_GRC_CURATED.DIM_OSCAL_SSP_ELEMENT
WHERE LOWER(ELEMENT_TYPE) IN ('component', 'components')
  AND LOWER(METADATA_JSON:type::STRING) IN ('software', 'hardware')
QUALIFY ROW_NUMBER() OVER (
    PARTITION BY LOWER(METADATA_JSON:type::STRING)
    ORDER BY SOURCE_RECORD_ID, OSCAL_UUID
) <= 50
ORDER BY COMPONENT_TYPE, SOURCE_RECORD_ID, OSCAL_UUID;
