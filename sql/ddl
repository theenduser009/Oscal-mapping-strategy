SELECT
    p.value:name::STRING AS mapped_field,
    COUNT(DISTINCT d.SOURCE_RECORD_ID) AS source_records
FROM RTX_ENTERPRISESERVICES_DEV.ES_ESC_GRC_CURATED.DIM_OSCAL_ASSESSMENT_RESULTS_ELEMENT d,
     LATERAL FLATTEN(INPUT => d.METADATA_JSON:props) p
WHERE d.ELEMENT_TYPE = 'observations'
GROUP BY 1
ORDER BY 1;
